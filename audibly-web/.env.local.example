# Supabase (auth) - public, used by the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use either: legacy anon key (JWT) or new publishable key (sb_publishable_...). Both work with the client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_or_sb_publishable_key

# Optional: only set if you use the separate .NET API (Audibly.Api). Leave empty to use built-in API on Vercel.
NEXT_PUBLIC_API_URL=

# Supabase JWT - server-only, for API route auth (verifies user JWTs). Still required; separate from anon/publishable.
SUPABASE_JWT_SECRET=your_jwt_secret_from_supabase_project_settings_api
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1

# Cloudflare R2 - server-only, no credit card required (cloudflare.com)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=audibly
R2_PREFIX=
# If your bucket is in EU jurisdiction, set: R2_JURISDICTION=eu
